<?xml version="1.0"?>
<ruleset name="Brumisphere">
	<description>Conventions WordPress appliquées au socle de thème Brumisphère.</description>

	<file>src</file>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<rule ref="WordPress">
		<!-- Les classes suivent PSR-4 : Path.php, pas class-path.php. -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="brumisphere"/>
				<element value="Brumisphere\ThemeCore"/>
			</property>
		</properties>
	</rule>

	<!--
		Le socle est consommé par des sites dont la version de PHP varie selon le
		webspace IONOS. La borne basse est donc celle du composer.json, pas celle du
		poste de développement.
	-->
	<!-- Crochets publics nommés brumisphere/core/… : « / » admis comme séparateur. Les
	     renommer casserait les thèmes clients qui s'y accrochent. -->
	<rule ref="WordPress.NamingConventions.ValidHookName">
		<properties>
			<property name="additionalWordDelimiters" value="/"/>
		</properties>
	</rule>

	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="8.2-"/>
	<config name="minimum_wp_version" value="6.5"/>
</ruleset>
